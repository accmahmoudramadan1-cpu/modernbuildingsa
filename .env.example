# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Cloud API (Meta) Configuration
# Verify Token set in Meta App Dashboard Webhook settings
WHATSAPP_VERIFY_TOKEN=modern_building_verify_2026

# Meta WhatsApp Cloud API credentials for sending messages
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token

# Utility Template Configuration (for Invoices)
WHATSAPP_INVOICE_TEMPLATE_NAME=invoice_utility
WHATSAPP_INVOICE_TEMPLATE_LANG=ar

# Secret API key for OraNT Python Synchronizer script (optional but recommended)
ORACLE_SYNC_API_KEY=modern_building_orant_sync_secret_2026
