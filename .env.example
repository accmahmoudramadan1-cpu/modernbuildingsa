# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Cloud API (Meta) Configuration
# Verify Token set in Meta App Dashboard Webhook settings (Default fallback: modern_building_verify_2026)
WHATSAPP_VERIFY_TOKEN=modern_building_verify_2026

# Meta WhatsApp Cloud API credentials for sending messages (Optional / For sending messages)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
